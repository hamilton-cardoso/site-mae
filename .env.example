# Valores privados do servidor. Copie para .env.local.
# Escape o dólar inicial da chave de API como no exemplo.
ASAAS_ENV=sandbox
ASAAS_API_KEY=\$aact_hmlg_substitua_pela_sua_chave
ASAAS_PIX_KEY=
ASAAS_WEBHOOK_TOKEN=
# URL HTTPS oficial do site. Preencha para habilitar o checkout de cartão.
ASAAS_CARD_RETURN_ORIGIN=
ADMIN_PASSWORD=

# Use a conexão com pool no site e a conexão direta para aplicar o esquema.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
